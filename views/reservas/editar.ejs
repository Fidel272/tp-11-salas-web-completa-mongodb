<section class="seccion-formulario">
    <p class="subtitulo-area"><%= titulo %></p>
    <h2>Editar Reserva</h2>

    <% if (error) { %>
        <div class="alerta-error" role="alert">
            <p><strong>Error:</strong> <%= error %></p>
        </div>
    <% } %>

    <form action="/reservas/<%= id %>/editar" method="POST" class="formulario-reserva">
        <div class="campo">
            <label for="estudiante">Nombre del Estudiante:</label>
            <input type="text" id="estudiante" name="estudiante" value="<%= valores.estudiante || '' %>" required>
        </div>

        <div class="campo">
            <label for="email">Correo Electrónico:</label>
            <input type="email" id="email" name="email" value="<%= valores.email || '' %>" required>
        </div>

        <div class="campo">
            <label for="sala">Sala:</label>
            <select id="sala" name="sala" required>
                <option value="">-- Seleccionar Sala --</option>
                <option value="Sala Norte" <%= valores.sala === "Sala Norte" ? "selected" : "" %>>Sala Norte</option>
                <option value="Sala Sur" <%= valores.sala === "Sala Sur" ? "selected" : "" %>>Sala Sur</option>
                <option value="Sala Multimedia" <%= valores.sala === "Sala Multimedia" ? "selected" : "" %>>Sala Multimedia</option>
            </select>
        </div>

        <div class="campo">
            <label for="fecha">Fecha:</label>
            <input type="date" id="fecha" name="fecha" value="<%= valores.fecha || '' %>" required>
        </div>

        <div class="campo">
            <label for="turno">Turno:</label>
            <select id="turno" name="turno" required>
                <option value="">-- Seleccionar Turno --</option>
                <option value="Mañana" <%= valores.turno === "Mañana" ? "selected" : "" %>>Mañana</option>
                <option value="Tarde" <%= valores.turno === "Tarde" ? "selected" : "" %>>Tarde</option>
                <option value="Noche" <%= valores.turno === "Noche" ? "selected" : "" %>>Noche</option>
            </select>
        </div>

        <div class="campo">
            <label for="personas">Cantidad de Personas (1-6):</label>
            <input type="number" id="personas" name="personas" min="1" max="6" value="<%= valores.personas || '' %>" required>
        </div>

        <div class="campo">
            <label for="estado">Estado:</label>
            <select id="estado" name="estado" required>
                <option value="">-- Seleccionar Estado --</option>
                <option value="pendiente" <%= valores.estado === "pendiente" ? "selected" : "" %>>Pendiente</option>
                <option value="confirmada" <%= valores.estado === "confirmada" ? "selected" : "" %>>Confirmada</option>
            </select>
        </div>

        <!-- Contenedor de acciones unificado (siguiendo la estructura que conversamos) -->
        <div class="acciones-formulario">
            <a href="/reservas/<%= id %>" class="boton">Cancelar</a>
            <button type="submit" class="boton boton-primario">Guardar cambios</button>
        </div>
    </form>
</section>